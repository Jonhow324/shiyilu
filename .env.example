# Read Token：网页端编辑与 MCP 写入共用的一把密钥。
# 未设置时读取仍可用，所有写操作（POST/PATCH/DELETE、MCP 写工具）返回 401。
# 生成一个随机 token：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   # 或：openssl rand -hex 24
NAV_TOKEN=

# SQLite 数据库文件路径，默认 <项目根目录>/data/nav.db
NAV_DB_PATH=

# 服务器取封面和快照时走的代理。留空则直连。
# 访客打开收藏的网站不经过这里。代理要能从容器里访问到。
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1
